{
  "name": "alti",
  "version": "0.5.1",
  "private": false,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "webpack --config webpack.prod.js",
    "build-prod": "yarn run build",
    "build-dev": "webpack --config webpack.dev.js",
    "dev:server": "nodemon ./server/bin/www | bunyan --output short --time local",
    "dev:client": "webpack --config webpack.dev.js --watch",
    "start": "node server/server.js",
    "start-dev": "run-p dev:*"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{html,json,yaml,yml}": [
      "prettier --write"
    ],
    "*.{js,jsx}": [
      "eslint --cache --fix"
    ]
  },
  "nodemonConfig": {
    "watch": [
      "server"
    ]
  },
  "dependencies": {
    "@instructure/emotion": "^10.10.0",
    "@instructure/ui-spinner": "^10.10.0",
    "@instructure/ui-text": "^10.10.0",
    "@instructure/ui-themes": "^10.10.0",
    "@instructure/ui-view": "^10.10.0",
    "bunyan": "^1.8.15",
    "buzzapi": "^2.1.0",
    "canvas-lms-api": "^1.0.2",
    "dotenv": "^16.4.7",
    "ejs": "~3.1.10",
    "express": "~4.21.2",
    "express-jwt": "^8.5.1",
    "html-webpack-plugin": "^5.6.3",
    "http-errors": "~2.0.0",
    "jsonwebtoken": "^9.0.2",
    "jwt-decode": "^4.0.0",
    "ltijs": "^5.9.6",
    "ltijs-sequelize": "^2.4.4",
    "parse-link-header": "^2.0.0",
    "prop-types": "^15.8.1",
    "qs": "^6.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "superagent": "^10.1.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/eslint-parser": "^7.25.9",
    "@babel/plugin-transform-runtime": "^7.25.9",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.26.3",
    "babel-loader": "^9.2.1",
    "clean-webpack-plugin": "^4.0.0",
    "css-loader": "^7.1.2",
    "eslint": "^9.17.0",
    "eslint-config-google": "^0.14.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-cypress": "^4.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.3",
    "husky": ">=9",
    "lint-staged": ">=15",
    "nodemon": "^3.1.9",
    "npm-run-all": "^4.1.5",
    "prettier": "3.4.2",
    "semver": "^7.6.3",
    "sinon": "19.0.2",
    "style-loader": "^4.0.0",
    "webpack": "^5.97.1",
    "webpack-cli": "^6.0.1",
    "webpack-merge": "^6.0.1"
  }
}
