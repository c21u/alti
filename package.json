{
  "name": "alti",
  "version": "0.5.1",
  "private": false,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "webpack --config webpack.prod.js",
    "build-prod": "yarn run build",
    "build-dev": "webpack --config webpack.dev.js",
    "postinstall": "patch-package",
    "start": "node server/server.js"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{html,json,yaml,yml}": [
      "prettier --write"
    ],
    "*.{js,jsx}": [
      "eslint --cache --fix"
    ]
  },
  "dependencies": {
    "@instructure/canvas-theme": "^11.5.0",
    "@instructure/emotion": "^11.5.0",
    "@instructure/ui-spinner": "^11.5.0",
    "@instructure/ui-text": "^11.5.0",
    "@instructure/ui-view": "^11.5.0",
    "buzzapi": "^2.1.2",
    "canvas-lms-api": "^1.0.6",
    "dotenv": "^17.3.1",
    "ejs": "~4.0.1",
    "express": "~5.2.1",
    "http-errors": "~2.0.1",
    "ltijs": "^5.9.9",
    "ltijs-sequelize": "^2.4.4",
    "pino": "^10.3.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/plugin-transform-runtime": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-react": "^7.28.5",
    "babel-eslint": "^10.1.0",
    "babel-loader": "^10.0.0",
    "css-loader": "^7.1.4",
    "eslint": "^9.7.0",
    "eslint-config-google": "^0.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-cypress": "^5.3.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "html-webpack-plugin": "^5.6.6",
    "husky": ">=9",
    "lint-staged": ">=16",
    "patch-package": "^8.0.1",
    "prettier": "3.8.1",
    "style-loader": "^4.0.0",
    "webpack": "^5.105.2",
    "webpack-cli": "^6.0.1",
    "webpack-merge": "^6.0.1"
  },
  "packageManager": "yarn@1.22.22+sha1.ac34549e6aa8e7ead463a7407e1c7390f61a6610"
}
